# Postgres (usado pelo docker-compose e pela API)
POSTGRES_USER=pulsefx
POSTGRES_PASSWORD=pulsefx
POSTGRES_DB=pulsefx
POSTGRES_PORT=5432
# String de conexão que a API usa (host "postgres" dentro do compose, "localhost" fora dele)
DATABASE_URL=postgres://pulsefx:pulsefx@localhost:5432/pulsefx

# API
PORT=3000
NODE_ENV=development
# Origem permitida para CORS (frontend rodando via `npm run dev:web`)
CORS_ORIGIN=http://localhost:5173

# Fontes externas
# TODO(spec): confirmar com gerente-produto se BCB exige chave (Olinda/SGS costumam ser públicos)
FRED_API_KEY=changeme
# Intervalo mínimo entre sincronizações da mesma série (política de TTL, ver seção 5/6 do readme.md)
SYNC_TTL_MINUTES=60
# Chave exigida no header X-Admin-Key para acionar POST /admin/sync (contingência de sync)
ADMIN_SYNC_KEY=changeme

# Clerk (autenticação - único ponto do MVP com login, feature 003-favoritos)
# Sem conta Clerk real neste ambiente: valores abaixo só satisfazem o formato exigido pelo
# SDK (prefixo/base64), não autenticam ninguém de verdade - troque por chaves reais de uma
# conta/instância de desenvolvimento Clerk (dashboard.clerk.com) para login funcionar.
# Ver readme.md seção 4.3.
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_cGxhY2Vob2xkZXIuY2xlcmsuYWNjb3VudHMuZGV2JA==

# Frontend (Vite expõe apenas variáveis prefixadas com VITE_)
VITE_API_BASE_URL=http://localhost:3000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_cGxhY2Vob2xkZXIuY2xlcmsuYWNjb3VudHMuZGV2JA==
